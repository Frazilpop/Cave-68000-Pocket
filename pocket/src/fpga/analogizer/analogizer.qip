# RndMnkIII's Analogizer adapter module, from github.com/RndMnkIII/Analogizer
# analogizer/ at 4b35f8306fd796cb29b404b018d6d318509b2a33 (MIT, (c) 2024
# RndMnkIII; yc_out.sv Mike Simone's, GPL-2.0-or-later; scandoubler.v Till
# Harbaum's, GPL-3.0-or-later; vga_out_sw.v after MiSTer's vga_out). Only the
# files the module instantiates. Two local changes, marked "Cave 68000" in the
# files: the scandoubler's divider (openFPGA_Pocket_Analogizer.v) and the
# PlayStation reader left out (openFPGA_Pocket_Analogizer_SNAC.sv).
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) openFPGA_Pocket_Analogizer.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) vga_out_sw.v]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) openFPGA_Pocket_Analogizer_SNAC.sv]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) clock_divider_fract.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) serlatch_gc.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pcengine_gc.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pcengine_game_controller_multitap.v]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) yc_out.sv]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) scandoubler.v]
